{% stylesheet %}
    body.rock-blank {
        background: #000 !important;
        padding: 2rem;
        }
    main {
        min-height: 80vh;
        background-color: #000;
        }
    div#bid_19970 {
        width: 100%;
        }
    #__ftg-redeem {
        width: 100%;
        }
    #scan-btn, #cancel-btn {
    width: 100%;
    outline: none;
    color: #fff;
    font-size: 2rem;
    font-weight: 700;
    padding-block: 1rem;
    margin-block: 4rem;
    text-transform: uppercase;
    border-radius: 12rem;
    transition: all ease-in-out .2s;
    height: fit-content;
    background: hsl(120 100% 25%);
    border: 2px solid hsl(120 100% 35%);
    }

    #scanner-screen {
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        margin: 0;
    }
        #video {
            width: 100%;
            min-height: 500px;
            border-radius: 8px;
        }
        #canvas {
            display: none;
        }
    #cancel-btn {
        background: hsl(0 81% 39%);
        border: 2px solid hsl(0 81% 60%);
    }


/* Alert Styling */
.alert {
    padding: 1.5rem;
    border-radius: 24px;
    font-size: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 2rem;

    &.alert-danger {
        background-color: hsl(6, 77%, 27%);
        color: #fff;
    }
    &.alert-success {
        background-color: hsl(147deg 79% 28%);
        color: hsl(147deg 39% 94%);
    }
}
.__ftg-response-msg {

    i {
        font-size: 4.5rem;

        text-align: center;

    }
}
.panel.panel-block,
.panel-body {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
}
/* Hide all Rock UI */
.panel-heading,
.block-configuration,
.zone-configuration {
    display: none !important;
}
/* Camera button - fixed size */
.__ftg-backtoscan {
    margin-top: auto;
    max-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
}
.__ftg-backtoscan-button {
    font-size: 3.1rem;
    padding: 1.5rem;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: hsl(0 0% 70%);
    border: 2px solid hsl(0 0% 90%);
    color: #000;

    &:active {
        background: hsl(0 0% 80%);
        }
}

#zone-main {

    .zone-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        width: 100% !important;
        min-height: 90vh;
        }
}
{% endstylesheet %}
